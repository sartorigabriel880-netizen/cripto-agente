# MODELO de secrets do Streamlit — NAO coloque a chave real aqui no repositorio.
#
# Use este arquivo apenas como referencia. A chave de verdade voce cola direto
# no painel do Streamlit Community Cloud, em:
#   App -> Settings -> Secrets
# (ou, para rodar local, crie um arquivo .streamlit/secrets.toml com os valores
#  reais — ele esta no .gitignore e NAO vai para o GitHub).

ANTHROPIC_API_KEY = "sk-ant-api03-...sua-chave-completa-aqui..."

# Opcional: protege o painel com senha (recomendado quando publicado na nuvem,
# para so voce conseguir abrir). Sem esta linha, o painel abre direto.
senha_painel = "escolha-uma-senha"

# Opcional: trocar o modelo do Claude (padrao = claude-sonnet-4-6)
# MODELO_CLAUDE = "claude-sonnet-4-6"
